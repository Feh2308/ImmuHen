# Notificacoes externas por email. Sem essas variaveis o sistema salva as
# notificacoes internas, mas nao consegue entregar email fora do app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
NOTIFICATION_FROM_EMAIL=
