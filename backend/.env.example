DATABASE_URL="postgresql://usuario:senha@host:5432/granja"
VACITECH_STATE_STORAGE=database
SUBSCRIPTION_ENFORCEMENT=off
PORT=3001
CORS_ORIGIN=https://app-vacinador.seu-dominio.com,https://granja-system.seu-dominio.com
OWNER_ADMIN_KEY=senha-para-entrar-no-painel-do-dono
SUBSCRIPTION_ADMIN_KEY=troque-esta-chave
AUTH_SECRET=troque-por-uma-chave-grande-e-secreta
API_PUBLIC_URL=https://api.seu-dominio.com
FRONTEND_PUBLIC_URL=https://granja-system.seu-dominio.com
SUBSCRIPTION_PRICE=99.90
