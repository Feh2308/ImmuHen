# Runtime/backend: use a URL pooler do Supabase em transaction mode, porta 6543.
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma migrations: use URL direta/session mode do Supabase, porta 5432.
DIRECT_URL="postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

VACITECH_STATE_STORAGE=database
SUBSCRIPTION_ENFORCEMENT=off
PORT=3001
CORS_ORIGIN=https://app-vacinador.seu-dominio.com,https://granja-system.seu-dominio.com
OWNER_ADMIN_KEY=senha-para-entrar-no-painel-do-dono
SUBSCRIPTION_ADMIN_KEY=troque-esta-chave
AUTH_SECRET=troque-por-uma-chave-grande-e-secreta
STOCK_ACCESS_KEY=
API_PUBLIC_URL=https://api.seu-dominio.com
FRONTEND_PUBLIC_URL=https://granja-system.seu-dominio.com
SUBSCRIPTION_PRICE=99.90
SUBSCRIPTION_CURRENCY=BRL

# Notificacoes externas por email. Sem essas variaveis o sistema salva as
# notificacoes internas, mas nao consegue entregar email fora do app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
NOTIFICATION_FROM_EMAIL=

# Alternativa recomendada para servidor online: Resend por API HTTP.
# Se usar Resend, configure EMAIL_PROVIDER=resend.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
RESEND_FROM_EMAIL=
