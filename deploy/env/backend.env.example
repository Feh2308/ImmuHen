PORT=3001
NODE_ENV=production

# Troque todas as chaves abaixo antes de colocar cliente real.
AUTH_SECRET=troque-por-uma-chave-com-40-caracteres-ou-mais
OWNER_ADMIN_KEY=troque-por-uma-senha-forte-do-dono
SUBSCRIPTION_ADMIN_KEY=troque-por-outra-chave-forte

# O Access Token do Mercado Pago fica somente no backend.
MP_ACCESS_TOKEN=APP_USR-seu-access-token-de-producao

# Ajuste para seu dominio real.
API_PUBLIC_URL=https://api.seudominio.com.br
FRONTEND_PUBLIC_URL=https://app.seudominio.com.br
CORS_ORIGIN=https://app.seudominio.com.br,https://vacinador.seudominio.com.br

SUBSCRIPTION_PRICE=99.90
SUBSCRIPTION_CURRENCY=BRL

# Notificacoes externas por email. Configure no servidor central para enviar de verdade.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
NOTIFICATION_FROM_EMAIL=
