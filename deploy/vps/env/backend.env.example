# Copie para /opt/immuhen/current/backend/.env na VPS.
# Nunca commite o arquivo real com senhas.

NODE_ENV=production
PORT=3001

# PostgreSQL da VPS.
# Para runtime normal, use a URL local do Postgres.
DATABASE_URL=postgresql://immuhen_user:TROQUE_A_SENHA@127.0.0.1:5432/immuhen?schema=public
DIRECT_URL=postgresql://immuhen_user:TROQUE_A_SENHA@127.0.0.1:5432/immuhen?schema=public

# Estado atual do sistema.
# Use "file" durante a migracao se os dados reais ainda estiverem em vacitech-data.json.
# Use "database" somente depois de importar/confirmar AppState no PostgreSQL.
VACITECH_STATE_STORAGE=file
VACITECH_DATA_FILE=/var/lib/immuhen/vacitech-data.json

# Controle de assinatura. Mantenha off enquanto pagamento nao estiver pronto.
SUBSCRIPTION_ENFORCEMENT=off

# Dominios publicos.
CORS_ORIGIN=https://app.seudominio.com.br,https://vacinador.seudominio.com.br
API_PUBLIC_URL=https://api.seudominio.com.br
FRONTEND_PUBLIC_URL=https://app.seudominio.com.br

# Segredos. Gere valores longos e guarde fora do Git.
OWNER_ADMIN_KEY=TROQUE_POR_SENHA_FORTE_DO_DONO
SUBSCRIPTION_ADMIN_KEY=TROQUE_POR_SENHA_FORTE_DE_ASSINATURA
AUTH_SECRET=TROQUE_POR_SEGREDO_GRANDE_FIXO
STOCK_ACCESS_KEY=

# Mensalidade/pagamento. Deixe vazio ate ativar Mercado Pago.
MP_ACCESS_TOKEN=
SUBSCRIPTION_PRICE=99.90
SUBSCRIPTION_CURRENCY=BRL

# Email. Configure quando for enviar notificacoes reais.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
NOTIFICATION_FROM_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
