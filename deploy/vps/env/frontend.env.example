# Copie para frontend/.env.production antes do build na VPS.

VITE_API_URL=https://api.seudominio.com.br

# Se usar um unico IP/dominio sem subdominio, use:
# VITE_VACCINATOR_APP_URL=http://187.127.2.184/vacinador
#
# Se usar dominio/subdominio depois, use:
# VITE_VACCINATOR_APP_URL=https://app.seudominio.com.br/vacinador
VITE_VACCINATOR_APP_URL=https://app.seudominio.com.br/vacinador
VITE_ENABLE_PAYMENTS=false
